{
  "name": "casa-domotica-ia",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "check:env": "node scripts/check-env.mjs",
    "deploy:check": "node scripts/preflight-deploy.mjs",
    "deploy:check:all": "node scripts/preflight-deploy.mjs --require-supabase",
    "test:backend": "node scripts/run-backend-tests.mjs",
    "verify:source": "node scripts/preflight-deploy.mjs --allow-dirty --skip-network",
    "verify": "npm run check:env && npm run frontend:build && npm run test:backend",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset --local",
    "supabase:status": "supabase status"
  },
  "devDependencies": {
    "supabase": "2.109.1"
  }
}
