# Copia este archivo como .env y completa las credenciales necesarias.
# backend/.env esta ignorado por Git. No copies secretos al frontend ni uses
# el prefijo NEXT_PUBLIC_ para ninguna variable de este archivo.

# IA. OPENAI_API_KEY es un secreto exclusivo del servidor.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
OPENAI_TRANSCRIBE_FALLBACK_MODEL=whisper-1
OPENAI_MAX_OUTPUT_TOKENS=700
OPENAI_TTS_ENABLED=true
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=marin
OPENAI_TTS_RESPONSE_FORMAT=mp3
OPENAI_TTS_INSTRUCTIONS="Habla en espanol latino con tono claro, cercano, profesional y tranquilo."
AI_TEMPERATURE=0.45
AI_RESPONSE_STYLE="natural, claro, cercano y con criterio tecnico"

# Para Ollama local usa AI_PROVIDER=local y ajusta el modelo.
LOCAL_AI_MODEL=qwen2:7b-instruct-q4_0

# URLs locales. En produccion reemplaza por los origenes HTTPS exactos y por
# la URL publica de la API. No uses * en CORS cuando se envian credenciales.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001
PUBLIC_API_URL=http://localhost:8000

# Supabase. Para la aplicacion completa, completa los tres primeros valores.
# SUPABASE_PUBLISHABLE_KEY valida solicitudes de usuarios. SUPABASE_SECRET_KEY
# es privilegiada y debe existir solamente en el backend/servidor.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=

# Compatibilidad legacy solamente si aun no migraste a SUPABASE_SECRET_KEY:
# SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AUDIO_BUCKET=voice-audio
VOICE_AUDIO_RETENTION_DAYS=30
VOICE_AUDIO_MIN_BYTES=1500
VOICE_AUDIO_SAVE_DIR=./audios_recibidos

# Persistencia SQLite de respaldo cuando Supabase no esta configurado.
DEVICES_DB_PATH=./devices.db

# Pairing, presencia y expiracion de comandos/planes (segundos salvo indicacion).
PAIRING_TOKEN_MINUTES=60
DEVICE_ONLINE_WINDOW_SECONDS=120
DEVICE_COMMAND_TTL_SECONDS=300
VOICE_PLAN_TTL_SECONDS=300

# MQTT legacy. Deja usuario y contrasena vacios solo para un broker local sin
# autenticacion; en produccion configura TLS y credenciales seguras.
MQTT_SERVER=127.0.0.1
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
MQTT_TOPIC_LUCES=casa/esp32/luces
MQTT_DEVICE_TOPIC_PREFIX=afcr/devices

# Usada por el script de despliegue para impedir que vuelvan origenes antiguos.
AFCR_LEGACY_ORIGINS_ENABLED=false
