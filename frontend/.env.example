# Copia este archivo como .env.local para desarrollo. En Hostinger configura
# las mismas variables desde el panel y no subas el archivo local al repositorio.
#
# Todo valor NEXT_PUBLIC_* se incorpora al codigo que recibe el navegador.
# Nunca pongas aqui claves secretas de Supabase, service_role, OpenAI, SMTP,
# contrasenas, tokens privados ni credenciales del backend.

# Desarrollo local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Obten ambos valores desde Supabase > Connect. La clave publishable es la
# unica clave de Supabase permitida en el frontend; los datos deben protegerse
# con Row Level Security (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_SUPABASE_PUBLISHABLE_KEY

# Produccion (configurar en el proveedor, no descomentar obligatoriamente aqui):
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
# NEXT_PUBLIC_API_BASE_URL=https://api.your-domain.example
